{
  "name": "tectonic-hackathon",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "tectonic-hackathon",
      "workspaces": [
        "portal",
        "detection",
        "recorder"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "detection": {
      "name": "@tectonic/detection",
      "version": "0.1.0"
    },
    "form": {
      "name": "@tectonic/form",
      "version": "0.1.0",
      "extraneous": true,
      "dependencies": {
        "@tectonic/detection": "0.1.0"
      }
    },
    "node_modules/@tectonic/detection": {
      "resolved": "detection",
      "link": true
    },
    "node_modules/@tectonic/portal": {
      "resolved": "portal",
      "link": true
    },
    "node_modules/@tectonic/recorder": {
      "resolved": "recorder",
      "link": true
    },
    "portal": {
      "name": "@tectonic/portal",
      "version": "0.1.0"
    },
    "recorder": {
      "name": "@tectonic/recorder",
      "version": "0.1.0"
    }
  }
}
